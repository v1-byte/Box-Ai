# Box AI — environment template
# Copy to .env for local development. Never commit real secrets.

APP_RELEASE_STORE_PASSWORD=
APP_RELEASE_KEY_PASSWORD=

FIREBASE_FUNCTIONS_URL=

# Debug tokens (local development only)
APPCHECK_DEBUG_TOKEN_ANDROID=
APPCHECK_DEBUG_TOKEN_IOS=

# Optional: Hugging Face token for private/gated models
HUGGINGFACE_TOKEN=

# Optional cloud backends (leave empty for fully offline)
SUPABASE_URL=
SUPABASE_ANON_KEY=
PALSHUB_API_BASE_URL=

# App deep link scheme
APP_URL=boxai://app

# Feature flags (true/false)
ENABLE_PALSHUB_INTEGRATION=false
ENABLE_AUTHENTICATION=false
ENABLE_OFFLINE_MODE=true

# Google Sign-In (optional)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# --- Connector / scanner pack ---
# Optional GitHub token for higher rate limits on releases API
GITHUB_TOKEN=

# Cloudflare R2 (S3 API) for hosting models
CLOUDFLARE_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=boxai-models
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET=

# Public tunnel or R2.dev URL that serves manifest.json + GGUF files
CLOUDFLARE_TUNNEL_URL=https://models.yourdomain.trycloudflare.com
