# Box AI — environment template
# Copy to .env for local development. Never commit real secrets.

APP_RELEASE_STORE_PASSWORD=
APP_RELEASE_KEY_PASSWORD=

FIREBASE_FUNCTIONS_URL=

# Debug tokens (local development only)
APPCHECK_DEBUG_TOKEN_ANDROID=
APPCHECK_DEBUG_TOKEN_IOS=

# Optional: Hugging Face token for private/gated models
HUGGINGFACE_TOKEN=

# Optional cloud backends (leave empty for fully offline)
SUPABASE_URL=
SUPABASE_ANON_KEY=
PALSHUB_API_BASE_URL=

# App deep link scheme
APP_URL=boxai://app

# Feature flags (true/false)
ENABLE_PALSHUB_INTEGRATION=false
ENABLE_AUTHENTICATION=false
ENABLE_OFFLINE_MODE=true

# Google Sign-In (optional)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
